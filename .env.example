# 复制此文件为 .env，填入真实的 API 信息后保存
# .env 文件不会提交到 git，可安全存放密钥

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
LLM_MODEL=glm-5.2-107

# Chat 服务可单独覆盖共用的 LLM 配置；不需要时保持注释。
# CHAT_BASE_URL=https://your-chat-service.example/v1
# CHAT_API_KEY=your_chat_api_key_here
# CHAT_MODEL=your_chat_model_here

# direct：忽略系统代理；system：沿用系统代理；custom：使用指定代理。
CHAT_PROXY_MODE=direct
# CHAT_PROXY_URL=http://proxy.example:8080
CHAT_TIMEOUT_SECONDS=90
CHAT_MAX_ATTEMPTS=2

# 向量检索模式：auto / remote / local / bm25。学校未开放 embedding 时建议 bm25。
RAG_EMBEDDING_BACKEND=bm25

# remote 模式的向量模型必须单独指定，不能填写聊天模型。
# EMBEDDING_MODEL=your_embedding_model_here
# 如果向量服务不与 LLM 共用地址或密钥，再取消下面两行注释并填写。
# EMBEDDING_BASE_URL=https://your-embedding-service.example/v1
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_PROXY_MODE=direct
# EMBEDDING_PROXY_URL=http://proxy.example:8080
# EMBEDDING_TIMEOUT_SECONDS=45
# EMBEDDING_MAX_ATTEMPTS=2
# EMBEDDING_MAX_CONCURRENCY=4

# local 模式只从本地加载 SentenceTransformer；默认禁止联网下载。
# LOCAL_EMBEDDING_MODEL=D:/models/text2vec-base-chinese
# LOCAL_EMBEDDING_DEVICE=cpu
# LOCAL_EMBEDDING_BATCH_SIZE=32
# LOCAL_EMBEDDING_ALLOW_DOWNLOAD=0

# 可选：本地 cross-encoder 重排模型。仅在已安装 sentence-transformers 且模型
# 已可用时填写；留空不会下载模型，也不会影响 BM25 / dense 检索。
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 最低相关性门槛（由 50 题离线基线校准）；设为 off 可单独关闭。
RAG_MIN_RRF_SCORE=0.03
RAG_MIN_BM25_SCORE=50.0

# 用户上传资料块在检索融合分上的加成，使其优先于指导书浮出；设为 0 关闭。
RAG_USER_UPLOAD_BOOST=0.01

# 会话默认持久化到 SQLite；填写 REDIS_URL 后切换 Redis。
RAG_SESSION_DB=.cache/online_rag/sessions.sqlite3
# REDIS_URL=redis://127.0.0.1:6379/0
RAG_SESSION_TTL_SECONDS=86400
RAG_DIAGNOSTICS_PATH=.cache/online_rag/rag_events.jsonl

# 文档与查询向量缓存默认使用 SQLite，适合多线程/多进程部署。
RAG_EMBEDDING_CACHE=.cache/online_rag/embeddings.sqlite3
RAG_QUERY_CACHE_PATH=.cache/online_rag/query_embeddings.sqlite3
