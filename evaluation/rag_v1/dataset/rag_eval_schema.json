{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-eval-question.schema.json",
  "title": "大学物理实验RAG测评题",
  "type": "object",
  "required": [
    "id", "version", "split", "suite", "experiment_ids", "experiment_names",
    "category", "difficulty", "question", "answerable", "expected_answer",
    "expected_points", "required_term_groups", "forbidden_claims", "source",
    "retrieval_expectation", "expected_source_tiers",
    "secondary_source_allowed", "example_data_allowed"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[RDB][0-9]{3}$"},
    "version": {"type": "string"},
    "split": {"enum": ["dev", "test"]},
    "suite": {"enum": ["representative", "deep", "boundary"]},
    "experiment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "experiment_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "category": {"type": "string"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "question": {"type": "string", "minLength": 8},
    "answerable": {"type": "boolean"},
    "expected_answer": {"type": "string", "minLength": 10},
    "expected_points": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "required_term_groups": {
      "type": "array",
      "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    },
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "expected_source_tiers": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["primary", "secondary", "example"]}
    },
    "secondary_source_allowed": {"type": "boolean"},
    "example_data_allowed": {"type": "boolean"},
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "section", "anchor"],
        "properties": {
          "relative_path": {"type": "string"},
          "section": {"type": "string"},
          "anchor": {"type": "string"},
          "authority": {"type": "string"}
        }
      }
    },
    "retrieval_expectation": {
      "type": "object",
      "required": ["relevant_experiment_ids", "top_k_hit_required"],
      "properties": {
        "relevant_experiment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "top_k_hit_required": {"type": "boolean"}
      }
    }
  },
  "additionalProperties": false
}
